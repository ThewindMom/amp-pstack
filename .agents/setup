#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# bun.lock uses lockfileVersion 2, which Bun older than 1.4 cannot parse.
if ! bun -e 'process.exit(Bun.semver.satisfies(Bun.version, ">=1.4.2") ? 0 : 1)'; then
	bun upgrade
fi

if ! command -v java >/dev/null || ! command -v javac >/dev/null; then
	sudo apt-get update -qq
	sudo apt-get install -y openjdk-17-jdk-headless
fi

# Statechart's Node suite executes TypeScript without a transpiler.
node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (!(major === 22 && minor >= 18 || major === 23 && minor >= 6 || major >= 24)) throw new Error("Statechart tests need Node 22.18–22.x or 23.6+")'
fonts=()
for package in fontconfig fonts-dejavu-core fonts-liberation fonts-urw-base35; do
	if [ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != "install ok installed" ]; then
		fonts+=("$package")
	fi
done
if [ "${#fonts[@]}" -gt 0 ]; then
	sudo apt-get update -qq
	sudo apt-get install -y "${fonts[@]}"
fi

tlc="$HOME/.cache/amp-pstack/tla2tools-1.7.4.jar"
mkdir -p "$(dirname "$tlc")"
if [ ! -f "$tlc" ]; then
	curl -fL --retry 2 https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar -o "$tlc.tmp"
	mv "$tlc.tmp" "$tlc"
fi
echo "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88  $tlc" | sha256sum -c -

bun install --frozen-lockfile
npm ci --prefix skills/statechart/scripts --ignore-scripts --no-audit --no-fund
